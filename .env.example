# =================================================================
# YamadaFinance — Environment Configuration
# =================================================================

# Telegram Bot Token (Obtain via @BotFather in Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Google Gemini API Key (Obtain via Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Database Configuration (PostgreSQL)
DB_USER=yamada_finance_user
DB_PASSWORD=yamada_finance_password
DB_HOST=db
DB_NAME=yamada_finance_db

# Full Database Connection String
DATABASE_URL=postgresql://yamada_finance_user:yamada_finance_password@db:5432/yamada_finance_db

# System Timezone
TIMEZONE=America/Santiago
TZ=America/Santiago
